# Build output
/build/
# out-of-source builds (build-asan, build-ubsan, etc.)
/build-*/
*.o
*.a
*.so
*.obj
*.lib
*.exe
*.pdb

# CMake FetchContent checkouts
/JUCE/
# CI-cached JUCE/Catch2 (FETCHCONTENT_BASE_DIR)
/.deps/

# Fetched tooling (pluginval prebuilt) — run-all-checks.sh / CI re-fetch it.
# Ignore everything under tools/ EXCEPT the committed sources: the target-validation
# package, the install-vst3 helper, and the drum-kit preset generator
# (gen_drumkits.py — the voicing source for the factory kits). These are tracked
# source, not downloaded binaries.
/tools/*
!/tools/target-validate/
!/tools/install-vst3.sh
!/tools/gen_drumkits.py

# Audition renders — regenerated on demand by the [.audition] test
# (tests/plugin/test_bass_auditions.cpp); large throwaway WAVs, never committed.
/docs/auditions/

# Local app data that must never be committed
*.settings
*.log

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
dist/

# Drum-kit tour renders (regenerated by the test suite; local audition only)
docs/audio-refs/
